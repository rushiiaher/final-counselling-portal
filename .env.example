# Copy this file to .env for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# See DEPLOYMENT.md for the full step-by-step guide.

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Pooled connection used by the running site (Neon/Supabase "pooled" URL)
DATABASE_URL=""
# Direct (non-pooled) connection used by `prisma db push`
DIRECT_URL=""

# ── Authentication ───────────────────────────────────────────────────────
# Your site's address, e.g. https://your-project.vercel.app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# 32+ random characters.  Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Security ─────────────────────────────────────────────────────────────
# Encrypts counselling notes & messages. MUST be exactly 64 hex characters.
# Generate:  openssl rand -hex 32
# Keep it safe — changing it later makes existing encrypted data unreadable.
ENCRYPTION_KEY=""
# Protects the /api/cron/* endpoints (16+ characters).  Generate:  openssl rand -hex 16
CRON_SECRET=""

# ── Application ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional integrations (uncomment only the ones you use) ──────────────
# RESEND_API_KEY=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
